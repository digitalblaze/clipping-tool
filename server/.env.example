AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_REGION=us-east-2
S3_BUCKET=kp-mm-kpevideo
SAT_RAW_PREFIX=SAT/RAW/
SAT_PROCESSED_PREFIX=SAT/PROCESSED/
PORT=3001

GOOGLE_SHEET_ID=1Vt9himNM4Neo0FiVL6Fxaf2QmqOUuj0vsydQr_q5FDk
# Base64 of the whole service-account JSON key. A plain GOOGLE_PRIVATE_KEY
# fails on Node 24 (ERR_OSSL_UNSUPPORTED) because env storage mangles the
# newlines: base64 -i service-account.json
GOOGLE_SERVICE_ACCOUNT_JSON_B64=base64_of_service_account_json

# Shared secret with the sheet's Apps Script (its CLIP_SERVICE_TOKEN property).
# Its CLIP_SERVICE_URL must point at POST /api/clip-jobs on this server.
CLIP_SERVICE_TOKEN=shared_secret_here
